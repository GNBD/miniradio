  },
  "target": {
    "board": "ESP32-S3-N16R8",
    "firmware": "GNBD ATS Mini"
  },
  "ui": { "bg": "bg", "items": [] },
  "code": [],
  "menu": null,
  "settings": null,
  "menuLayout": "v",
  "settingsLayout": "v",
  "meta": {},
  "rules": [
    {
      "id": 1,
      "when": { "type": "rssi_updated", "param": "" },
      "if": [
        { "type": "rssi_lt", "param": "15" }
      ],
      "do": [
        { "type": "toast", "param": "WEAK SIGNAL" }
      ]
    }
  ]
